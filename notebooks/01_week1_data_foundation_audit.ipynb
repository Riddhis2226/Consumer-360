   "source": [
    "if engine is not None:\n",
    "    try:\n",
    "        with engine.connect() as conn:\n",
    "            counts = pd.read_sql_query(text(\"\"\"\n",
    "                SELECT 'analytics.dim_customer' AS object_name, COUNT(*) AS row_count FROM analytics.dim_customer\n",
    "                UNION ALL SELECT 'analytics.dim_product', COUNT(*) FROM analytics.dim_product\n",
    "                UNION ALL SELECT 'analytics.fact_sales', COUNT(*) FROM analytics.fact_sales\n",
    "            \"\"\"), conn)\n",
    "            fact = pd.read_sql_query(text(\"\"\"\n",
    "                SELECT COUNT(*) AS fact_rows, COUNT(DISTINCT staging_id) AS distinct_staging_ids\n",
    "                FROM analytics.fact_sales\n",
    "            \"\"\"), conn)\n",
    "            unknown = pd.read_sql_query(text(\"\"\"\n",
    "                SELECT (SELECT COUNT(*) FROM analytics.dim_customer WHERE customer_key=0) AS unknown_customers,\n",
    "                       (SELECT COUNT(*) FROM analytics.dim_product WHERE product_key=0) AS unknown_products\n",
    "            \"\"\"), conn)\n",
    "            orphans = pd.read_sql_query(text(\"\"\"\n",
    "                SELECT COUNT(*) FILTER (WHERE c.customer_key IS NULL) AS orphan_customer_rows,\n",
    "                       COUNT(*) FILTER (WHERE p.product_key IS NULL) AS orphan_product_rows,\n",
    "                       COUNT(*) FILTER (WHERE s.staging_id IS NULL) AS orphan_staging_rows\n",
    "                FROM analytics.fact_sales f\n",
    "                LEFT JOIN analytics.dim_customer c ON f.customer_key=c.customer_key\n",
    "                LEFT JOIN analytics.dim_product p ON f.product_key=p.product_key\n",
    "                LEFT JOIN staging.retail_transactions s ON f.staging_id=s.staging_id\n",
    "            \"\"\"), conn)\n",
    "        display(counts); display(fact); display(unknown); display(orphans)\n",
    "        count_map = dict(zip(counts.object_name,counts.row_count))\n",
    "        compare(\"dim_customer row count\",int(count_map[\"analytics.dim_customer\"]),BASELINE[\"customers\"])\n",
    "        compare(\"dim_product row count\",int(count_map[\"analytics.dim_product\"]),BASELINE[\"products\"])\n",
    "        compare(\"fact_sales row count\",int(count_map[\"analytics.fact_sales\"]),BASELINE[\"fact\"])\n",
    "        compare(\"Fact staging_id uniqueness\",int(fact.distinct_staging_ids.iloc[0]),int(fact.fact_rows.iloc[0]))\n",
    "        compare(\"Unknown customer member count\",int(unknown.unknown_customers.iloc[0]),1)\n",
    "        compare(\"Unknown product member count\",int(unknown.unknown_products.iloc[0]),1)\n",
    "        for col in orphans.columns:\n",
    "            compare(f\"Zero {col}\",int(orphans[col].iloc[0]),0)\n",
    "    except Exception as exc:\n",
    "        print(\"Star schema audit unavailable:\",type(exc).__name__,str(exc)[:250])\n",
    "        add_check(\"Star schema audit\",\"NOT VERIFIED\",type(exc).__name__,\"Dimensions, fact, keys and orphan checks\")"
   ]
