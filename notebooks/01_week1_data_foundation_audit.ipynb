   "source": [
    "from pathlib import Path\n",
    "import hashlib, sys\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "# Find the project root from the notebook's current working directory or its parents.\n",
    "_candidates = [Path.cwd(), *Path.cwd().parents]\n",
    "ROOT = next((p for p in _candidates if (p / \"pyproject.toml\").exists() and (p / \"database\").exists()), Path.cwd())\n",
    "RAW = ROOT / \"data\" / \"raw\"\n",
    "REPORT = ROOT / \"reports\" / \"ingestion_report.json\"\n",
    "MIGRATIONS = ROOT / \"database\" / \"migrations\"\n",
    "ERD = ROOT / \"database\" / \"diagrams\" / \"consumer360_star_schema.mmd\"\n",
    "BENCHMARK = ROOT / \"database\" / \"queries\" / \"006_performance_benchmark.sql\"\n",
    "FILES = [RAW / \"online_retail_II_2009-10.csv\", RAW / \"online_retail_II_2010-11.csv\"]\n",
    "COLUMNS = [\"Invoice\", \"StockCode\", \"Description\", \"Quantity\", \"InvoiceDate\", \"Price\", \"Customer ID\", \"Country\"]\n",
    "\n",
    "BASELINE = {\"source_2009\":525461, \"source_2010\":541910, \"overlap\":22523,\n",
    "            \"staging\":1044848, \"customers\":5943, \"products\":5305, \"fact\":1044848,\n",
    "            \"scv_customers\":5942, \"purchasers\":5852, \"no_orders\":90,\n",
    "            \"scv_revenue\":17117089.2970, \"target_ms\":2000.0}\n",
    "checks = []\n",
    "\n",
    "def add_check(name, status, observed=None, expected=None, note=None):\n",
    "    checks.append({\"check\":name,\"status\":status,\"observed\":observed,\"expected\":expected,\"note\":note})\n",
    "\n",
    "def compare(name, observed, expected, tol=0):\n",
    "    if observed is None or pd.isna(observed):\n",
    "        status = \"NOT VERIFIED\"\n",
    "    elif isinstance(expected, (int,float)):\n",
    "        status = \"PASS\" if abs(float(observed)-float(expected)) <= tol else \"REVIEW\"\n",
    "    else:\n",
    "        status = \"PASS\" if observed == expected else \"REVIEW\"\n",
    "    add_check(name,status,observed,expected)\n",
    "\n",
    "print(\"Project root:\", ROOT)\n",
    "print(\"Python:\", sys.version.split()[0])\n",
    "from sqlalchemy import text\n"
   ]
  },
