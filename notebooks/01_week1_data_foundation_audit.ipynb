   "source": [
    "engine = None\n",
    "try:\n",
    "    sys.path.insert(0, str(ROOT / \"src\"))\n",
    "    from consumer360.database.connection import get_engine\n",
    "    engine = get_engine()\n",
    "    with engine.connect() as conn:\n",
    "        identity = pd.read_sql_query(text(\"SELECT current_database() AS database_name, current_user AS database_user, version() AS server_version\"), conn)\n",
    "    display(identity)\n",
    "    add_check(\"PostgreSQL connection\",\"PASS\",\"Connected\",\"Connected\")\n",
    "except Exception as exc:\n",
    "    print(\"Connection unavailable:\",type(exc).__name__,str(exc)[:250])\n",
    "    add_check(\"PostgreSQL connection\",\"NOT VERIFIED\",type(exc).__name__,\"Connected\")\n",
    "\n",
    "if engine is not None:\n",
    "    try:\n",
    "        with engine.connect() as conn:\n",
    "            staging = pd.read_sql_query(text(\"\"\"\n",
    "                SELECT COUNT(*) AS row_count,\n",
    "                       COUNT(DISTINCT staging_id) AS distinct_staging_ids,\n",
    "                       COUNT(*) FILTER (WHERE customer_id IS NULL) AS missing_customer_id,\n",
    "                       COUNT(*) FILTER (WHERE description IS NULL) AS missing_description,\n",
    "                       COUNT(*) FILTER (WHERE unit_price = 0) AS zero_unit_price,\n",
    "                       COUNT(*) FILTER (WHERE unit_price < 0) AS negative_unit_price,\n",
    "                       COUNT(*) FILTER (WHERE quantity < 0) AS negative_quantity,\n",
    "                       COUNT(*) FILTER (WHERE is_cancellation) AS cancellation_rows,\n",
    "                       COUNT(*) FILTER (WHERE source_file IS NULL OR source_row_number IS NULL) AS missing_lineage,\n",
    "                       MIN(invoice_date) AS first_invoice_date,\n",
    "                       MAX(invoice_date) AS last_invoice_date\n",
    "                FROM staging.retail_transactions\n",
    "            \"\"\"), conn)\n",
    "        display(staging)\n",
    "        s = staging.iloc[0]\n",
    "        compare(\"Staging row count\",int(s.row_count),BASELINE[\"staging\"])\n",
    "        compare(\"Staging ID uniqueness\",int(s.distinct_staging_ids),int(s.row_count))\n",
    "        compare(\"Staging lineage completeness\",int(s.missing_lineage),0)\n",
    "    except Exception as exc:\n",
    "        print(\"Staging query unavailable:\",type(exc).__name__,str(exc)[:250])\n",
    "        add_check(\"Staging audit\",\"NOT VERIFIED\",type(exc).__name__,\"staging.retail_transactions query\")"
   ]
