   "source": [
    "frames, source_rows = {}, []\n",
    "for path in FILES:\n",
    "    if not path.exists():\n",
    "        add_check(f\"Source file: {path.name}\", \"NOT VERIFIED\", \"Not found\", \"Available in data/raw\")\n",
    "        continue\n",
    "    try:\n",
    "        df = pd.read_csv(path, encoding=\"utf-8-sig\", dtype=\"string\", low_memory=False)\n",
    "        frames[path.name] = df\n",
    "        missing = sorted(set(COLUMNS) - set(df.columns))\n",
    "        if not missing:\n",
    "            dates = pd.to_datetime(df[\"InvoiceDate\"], errors=\"coerce\")\n",
    "            min_date, max_date = dates.min(), dates.max()\n",
    "        else:\n",
    "            min_date = max_date = None\n",
    "        source_rows.append({\"file\":path.name,\"rows\":len(df),\"columns\":len(df.columns),\n",
    "            \"missing_required_columns\":missing,\"min_date\":min_date,\"max_date\":max_date,\n",
    "            \"size_bytes\":path.stat().st_size,\n",
    "            \"sha256\":hashlib.sha256(path.read_bytes()).hexdigest()})\n",
    "        add_check(f\"Required columns: {path.name}\", \"PASS\" if not missing else \"FAIL\", missing, [])\n",
    "    except Exception as exc:\n",
    "        add_check(f\"Read source file: {path.name}\", \"NOT VERIFIED\", type(exc).__name__, \"Readable CSV\")\n",
    "\n",
    "source_audit = pd.DataFrame(source_rows)\n",
    "display(source_audit if not source_audit.empty else pd.DataFrame(columns=[\"file\",\"rows\",\"columns\",\"missing_required_columns\",\"min_date\",\"max_date\",\"size_bytes\",\"sha256\"]))\n",
    "if len(source_rows) == 2:\n",
    "    rows_by_file = {r[\"file\"]: r[\"rows\"] for r in source_rows}\n",
    "    compare(\"2009–10 source row count\", rows_by_file.get(FILES[0].name), BASELINE[\"source_2009\"])\n",
    "    compare(\"2010–11 source row count\", rows_by_file.get(FILES[1].name), BASELINE[\"source_2010\"])\n",
    "\n",
    "if len(frames) == 2 and all(set(COLUMNS).issubset(frames[p.name].columns) for p in FILES):\n",
    "    left, right = [frames[p.name][COLUMNS].fillna(\"<NULL>\").astype(str) for p in FILES]\n",
    "    lc, rc = left.value_counts(), right.value_counts()\n",
    "    overlap = int(pd.concat([lc,rc],axis=1).fillna(0).min(axis=1).sum())\n",
    "    retained = len(left) + len(right) - overlap\n",
    "    print(\"Cross-file matching occurrences:\", overlap)\n",
    "    compare(\"Cross-file overlap occurrences\", overlap, BASELINE[\"overlap\"])\n",
    "    compare(\"Retained rows after overlap handling\", retained, BASELINE[\"staging\"])\n",
    "else:\n",
    "    add_check(\"Cross-file overlap\", \"NOT VERIFIED\", \"Both readable files with required columns are needed\", BASELINE[\"overlap\"])\n"
   ]
  },
