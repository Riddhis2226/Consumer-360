erDiagram
    DIM_CUSTOMER ||--o{ FACT_SALES : customer_key
    DIM_PRODUCT ||--o{ FACT_SALES : product_key
    STAGING_RETAIL_TRANSACTIONS ||--o| FACT_SALES : staging_id

    DIM_CUSTOMER {
        bigint customer_key PK
        varchar customer_id UK
        varchar country
        integer country_count
        timestamp first_purchase_at
        timestamp last_purchase_at
        boolean is_unknown
    }

    DIM_PRODUCT {
        bigint product_key PK
        varchar stock_code UK
        text canonical_description
        varchar product_class
        boolean is_merchandise
        boolean needs_review
    }

    STAGING_RETAIL_TRANSACTIONS {
        bigint staging_id PK
    }

    FACT_SALES {
        bigint fact_sales_key PK
        bigint staging_id FK
        bigint customer_key FK
        bigint product_key FK
        varchar invoice
        timestamp invoice_date
        varchar source_category
        varchar reporting_category
        integer quantity
        numeric unit_price
        numeric merchandise_line_amount
        numeric non_merchandise_line_amount
    }
